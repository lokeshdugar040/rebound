<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rebound — Adobe CEP extension manifest.

  Declares one extension: com.meszmate.rebound.panel, the Rebound panel.
  Settings live inside that panel (an in-panel dialog), not a second window.

  Host range targets After Effects 2019 (16.0) and newer. CEP 9 runtime
  (CSXS 9.0) is the floor; it ships with AE 2019+ and supports the CEF
  features (Node.js integration, file access) Rebound relies on.

  CEFCommandLine flags (declared per extension below). Flag names are written
  here without their leading dashes on purpose: XML forbids a double hyphen
  inside a comment, and a manifest CEP cannot parse makes the whole extension
  disappear from Window > Extensions.

    enable-nodejs               gives the panel a Node.js runtime. Load
                                bearing, see the warning below.
    allow-file-access-from-files  lets the panel load local assets/icons
    disable-pinch               stops trackpad pinch from zooming the panel
    disable-gpu-compositing     added in c65a5bc. CEF's GPU compositing path
                                dropped the first raster of the inline SVG
                                icons, so they showed blank until something
                                rebuilt the DOM. Paired with the repaint kick
                                in client/js/main.js.

  Do not remove enable-nodejs. Advice circulates that CEP 12 (After Effects
  25.0 and newer) dropped its Node runtime and that the flag now crashes the
  renderer. It does not: Adobe's CEP 12 cookbook still ships Node 17.7.1 and
  still documents this flag. Removing it sets window.cep_node to undefined,
  which kills three things with no fallback:
    - the loopback ingest server, so the live Figma/Illustrator/Photoshop
      bridge cannot bind a port at all (client/js/core/ingest-server.js)
    - every image in an import, including offline .rbir files, because assets
      travel as base64 and only the Node path writes them to disk
    - WAV onset detection (client/js/features/audio.js)
  test/manifest.test.mjs fails if enable-nodejs, allow-file-access-from-files,
  or disable-gpu-compositing goes missing from this extension.
-->
<ExtensionManifest Version="9.0"
                   ExtensionBundleId="com.meszmate.rebound"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Rebound"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.meszmate.rebound.panel" Version="0.1.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[16.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <!-- Main panel -->
    <Extension Id="com.meszmate.rebound.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--disable-pinch</Parameter>
            <Parameter>--disable-gpu-compositing</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Rebound</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>520</Height>
            </Size>
            <MinSize>
              <Width>240</Width>
              <Height>320</Height>
            </MinSize>
            <MaxSize>
              <Width>1400</Width>
              <Height>2000</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./client/assets/icons/panel-normal.png</Icon>
            <Icon Type="RollOver">./client/assets/icons/panel-rollover.png</Icon>
            <Icon Type="DarkNormal">./client/assets/icons/panel-darknormal.png</Icon>
            <Icon Type="DarkRollOver">./client/assets/icons/panel-darkrollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>
</ExtensionManifest>
